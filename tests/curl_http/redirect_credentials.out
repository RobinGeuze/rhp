== custom headers, other host
GET /echo HTTP/1.1
Host: localhost:PORT
Accept: */*
X-Keep: yes
--

[redirects=1 code=200]

== USERPWD, other host
GET /echo HTTP/1.1
Host: localhost:PORT
Accept: */*
--

[redirects=1 code=200]

== USERNAME/PASSWORD, other host
GET /echo HTTP/1.1
Host: localhost:PORT
Accept: */*
--

[redirects=1 code=200]

== same host keeps everything (custom Authorization wins)
GET /echo HTTP/1.1
Host: 127.0.0.1:PORT
Accept: */*
Authorization: Bearer SECRET
Cookie: s=1
--

[redirects=1 code=200]

== UNRESTRICTED_AUTH
GET /echo HTTP/1.1
Host: localhost:PORT
Accept: */*
Authorization: Bearer SECRET
Cookie: s=1
--

[redirects=1 code=200]

== no follow

[redirects=0 code=302]

