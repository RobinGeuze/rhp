{
    "name": "rhp/suite-symfony-7.4",
    "description": "rhp test-suite ratchet: Symfony 7.4 components, installed from source so their Tests/ come along",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/cache": "7.4.22",
        "symfony/clock": "7.4.*",
        "symfony/config": "7.4.22",
        "symfony/console": "7.4.22",
        "symfony/dependency-injection": "7.4.22",
        "symfony/error-handler": "7.4.22",
        "symfony/event-dispatcher": "7.4.17",
        "symfony/filesystem": "7.4.21",
        "symfony/finder": "7.4.22",
        "symfony/http-foundation": "7.4.22",
        "symfony/http-kernel": "7.4.22",
        "symfony/mime": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/routing": "7.4.22",
        "symfony/stopwatch": "7.4.*",
        "symfony/string": "7.4.22",
        "symfony/translation": "7.4.*",
        "symfony/var-dumper": "7.4.22",
        "symfony/var-exporter": "7.4.22",
        "symfony/yaml": "7.4.22"
    },
    "require-dev": {
        "cache/integration-tests": "^1.0.3",
        "doctrine/dbal": "^3.6|^4",
        "egulias/email-validator": "^2.1.10|^3.1|^4",
        "league/html-to-markdown": "^5.0",
        "nikic/php-parser": "^5.0",
        "phpdocumentor/reflection-docblock": "^5.2|^6.0",
        "phpunit/phpunit": "^13.1",
        "predis/predis": "^1.1|^2.0",
        "psr/cache": "^1.0|^2.0|^3.0",
        "psr/log": "^1|^2|^3",
        "psr/simple-cache": "^1.0|^2.0|^3.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/deprecation-contracts": "^2.5|^3",
        "symfony/dom-crawler": "7.4.*",
        "symfony/emoji": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/framework-bundle": "7.4.22",
        "symfony/http-client": "7.4.*",
        "symfony/http-client-contracts": "^2.5|^3",
        "symfony/intl": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/polyfill-intl-icu": "^1.21",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/service-contracts": "^2.5|^3",
        "symfony/translation-contracts": "^2.5|^3",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/webpack-encore-bundle": "^1.0|^2.0",
        "twig/twig": "^3.12|^4.0"
    },
    "minimum-stability": "stable",
    "config": {
        "preferred-install": {
            "symfony/console": "source",
            "symfony/http-foundation": "source",
            "symfony/routing": "source",
            "symfony/yaml": "source",
            "symfony/var-dumper": "source",
            "symfony/http-kernel": "source",
            "symfony/dependency-injection": "source",
            "symfony/config": "source",
            "symfony/event-dispatcher": "source",
            "symfony/string": "source",
            "symfony/var-exporter": "source",
            "symfony/finder": "source",
            "symfony/error-handler": "source",
            "symfony/process": "source",
            "symfony/filesystem": "source",
            "symfony/cache": "source",
            "symfony/mime": "source",
            "symfony/translation": "source",
            "symfony/clock": "source",
            "symfony/stopwatch": "source",
            "*": "dist"
        },
        "allow-plugins": false,
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    }
}
